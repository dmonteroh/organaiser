{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflows.dev/schemas/task-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposedId",
    "title",
    "briefPath",
    "parentId",
    "dependencies",
    "startingStage",
    "claims",
    "acceptanceCriteria",
    "sizingBudget"
  ],
  "properties": {
    "proposedId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "briefPath": {
      "type": "string"
    },
    "parentId": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "startingStage": {
      "type": "string"
    },
    "claims": {
      "$ref": "https://ai-workflows.dev/schemas/board.schema.json#/$defs/claimSet"
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sizingBudget": {
      "$ref": "https://ai-workflows.dev/schemas/task-brief.schema.json#/$defs/sizingBudget"
    }
  }
}
