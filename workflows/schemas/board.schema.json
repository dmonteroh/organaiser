{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflows.dev/schemas/board.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "ai-workflows.dev/v1alpha1"
    },
    "kind": {
      "const": "Board"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "contractVersion"],
      "properties": {
        "id": {
          "type": "string"
        },
        "contractVersion": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "briefPath",
        "entry",
        "dependencies",
        "priority",
        "requiredWorkflowVersions",
        "claims",
        "verification",
        "enabled"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "briefPath": {
          "type": "string"
        },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflowId", "stageId"],
          "properties": {
            "workflowId": {
              "type": "string"
            },
            "stageId": {
              "type": "string"
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "description": "Lower sorts first."
        },
        "requiredWorkflowVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "claims": {
          "$ref": "#/$defs/claimSet"
        },
        "verification": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verificationCheck"
          }
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "claimSet": {
      "oneOf": [
        {
          "const": "unknown"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nonFile": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "verificationCheck": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "argv"],
          "properties": {
            "id": {
              "type": "string"
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cwd": {
              "type": "string"
            },
            "timeoutSecs": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "shell", "command"],
          "properties": {
            "id": {
              "type": "string"
            },
            "shell": {
              "const": true
            },
            "command": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "timeoutSecs": {
              "type": "integer"
            }
          }
        }
      ]
    }
  }
}
