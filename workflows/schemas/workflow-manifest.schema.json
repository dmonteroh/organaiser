{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflows.dev/schemas/workflow-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "ai-workflows.dev/v1alpha1"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "contractVersion"],
      "properties": {
        "id": {
          "type": "string"
        },
        "contractVersion": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "entryStage", "terminalOutcomes", "stages"],
      "properties": {
        "policy": {
          "type": "string"
        },
        "entryStage": {
          "type": "string"
        },
        "terminalOutcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["success", "attention", "neutral"],
          "properties": {
            "success": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "attention": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "neutral": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "caps": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["agent", "runner"]
        },
        "role": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "authority": {
          "type": "string",
          "enum": ["read-only", "task-document", "workspace-write"]
        },
        "freshSession": {
          "const": true
        },
        "capabilityClass": {
          "type": "string",
          "minLength": 1
        },
        "verdicts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "transitions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["malformedResult", "processFailure"],
          "properties": {
            "malformedResult": {
              "type": "integer"
            },
            "processFailure": {
              "type": "integer"
            }
          }
        },
        "predicate": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "agent"
              }
            }
          },
          "then": {
            "required": [
              "role",
              "prompt",
              "authority",
              "freshSession",
              "capabilityClass",
              "verdicts",
              "transitions",
              "retry"
            ]
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "runner"
              }
            }
          },
          "then": {
            "required": ["predicate", "transitions"],
            "not": {
              "anyOf": [
                {
                  "required": ["role"]
                },
                {
                  "required": ["prompt"]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "examples": [
    {
      "apiVersion": "ai-workflows.dev/v1alpha1",
      "kind": "Workflow",
      "metadata": {
        "id": "task-refinement",
        "contractVersion": "1.0.0"
      },
      "spec": {
        "policy": "../task-refinement-workflow.md",
        "entryStage": "analyst-initial",
        "terminalOutcomes": {
          "success": ["implementation-ready"],
          "attention": ["waiting-operator"],
          "neutral": []
        },
        "stages": [
          {
            "id": "analyst-initial",
            "kind": "agent",
            "role": "analyst",
            "prompt": "../subagents/analyst-prompt.md",
            "authority": "read-only",
            "freshSession": true,
            "capabilityClass": "analysis",
            "verdicts": ["implementation-ready", "needs-review", "blocked", "split-required"],
            "transitions": {
              "implementation-ready": "refinement-self-check",
              "needs-review": "refinement-self-check",
              "blocked": "refinement-self-check",
              "split-required": "refinement-self-check"
            },
            "retry": {
              "malformedResult": 1,
              "processFailure": 1
            }
          },
          {
            "id": "refinement-self-check",
            "kind": "runner",
            "predicate": "sections-complete",
            "transitions": {
              "true": "implementation-ready",
              "false": "analyst-initial"
            }
          }
        ]
      }
    }
  ]
}
